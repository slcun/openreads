# Douban ISBN Proxy — environment variables
# Copy to .env and adjust.

# Bind address (default: 0.0.0.0)
BIND_HOST=0.0.0.0

# Bind port (default: 8080)
BIND_PORT=8080

# SQLite cache file path (default: cache.db)
# DOUBAN_PROXY_CACHE_PATH takes precedence over CACHE_PATH
DOUBAN_PROXY_CACHE_PATH=/data/cache.sqlite3

# Cache TTL in seconds (default: 86400 = 24 h)
CACHE_TTL_SECONDS=86400

# Minimum interval between upstream requests in seconds (default: 2.0)
MINIMUM_REQUEST_INTERVAL_SECONDS=2.0

# HTTP request timeout in seconds (default: 30.0)
REQUEST_TIMEOUT_SECONDS=30.0
